{
  "manifest_version": 3,
  "name": "Rubi | Your All-in-One Smart Assistant",
  "short_name": "Rubi",
  "version": "4.1.0",
  "description": "Rubi, your all-in-one smart assistant: calendar, tasks, notes and shortcuts in your new tab, saved in your own Google account. No ads, no tracking.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": "icons/icon-32.png",
    "default_title": "Rubi"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "permissions": [
    "storage",
    "identity",
    "identity.email",
    "favicon",
    "alarms",
    "notifications",
    "contextMenus",
    "declarativeNetRequest",
    "offscreen",
    "scripting",
    "activeTab",
    "idle"
  ],
  "optional_permissions": [
    "bookmarks",
    "topSites",
    "webRequest"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*",
    "https://api.audd.io/*",
    "https://translate.googleapis.com/*",
    "https://www.thesportsdb.com/*"
  ],
  "oauth2": {
    "client_id": "PASTE_YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.frankfurter.app https://open.er-api.com https://api.coingecko.com https://api.navasan.tech https://query1.finance.yahoo.com https://query2.finance.yahoo.com https://api.audd.io https://api.github.com https://air-quality-api.open-meteo.com https://www.thesportsdb.com https://translate.googleapis.com"
  },
  "commands": {
    "shot-visible": {
      "suggested_key": {
        "default": "Alt+Shift+3"
      },
      "description": "Screenshot: visible part"
    },
    "shot-full": {
      "suggested_key": {
        "default": "Alt+Shift+1"
      },
      "description": "Screenshot: entire page"
    },
    "shot-area": {
      "suggested_key": {
        "default": "Alt+Shift+4"
      },
      "description": "Screenshot: select an area"
    }
  }
}
